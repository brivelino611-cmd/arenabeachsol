# ============================================================
# Copie este arquivo para ".env" e preencha com os dados reais.
# NUNCA envie o arquivo ".env" para o GitHub.
# ============================================================

# Porta em que o backend vai rodar
PORT=3000

# URL do frontend permitida a chamar a API (CORS)
FRONTEND_ORIGIN=http://localhost:5500

# ID da planilha do Google Sheets (está na URL da planilha)
# https://docs.google.com/spreadsheets/d/ESTE_TRECHO_AQUI/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Nome da aba usada para armazenar as reservas
GOOGLE_SHEETS_TAB_NAME=Reservas

# Credenciais da Conta de Serviço do Google (Service Account)
# Veja o README.md, seção 3, para o passo a passo completo.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUBSTITUA\n-----END PRIVATE KEY-----\n"

# Número de WhatsApp da Arena (apenas para referência no backend, se necessário)
ARENA_WHATSAPP=
